+fn resolve_range(
+    allowed: &RangeInclusive<u32>,
+    startup: &RangeInclusive<u32>,
+    min: u32,
+    max: u32,
+) -> Result<RangeInclusive<u32>> {
+    let (allowed_min, allowed_max) = (*allowed.start(), *allowed.end());
+    if min != 0 && !allowed.contains(&min) {
+        return Err(format!(
+            "min {} out of allowed range {}..={} MHz",
+            min, allowed_min, allowed_max
+        )
+        .into());
+    }
+    if max != 0 && !allowed.contains(&max) {
+        return Err(format!(
+            "max {} out of allowed range {}..={} MHz",
+            max, allowed_min, allowed_max
+        )
+        .into());
+    }
+
+    let resolved_min = if min == 0 { *startup.start() } else { min };
+    let resolved_max = if max == 0 { *startup.end() } else { max };
+    if resolved_min > resolved_max {
+        return Err(format!(
+            "invalid range: effective min {} > effective max {}",
+            resolved_min, resolved_max
+        )
+        .into());
+    }
+    Ok(resolved_min..=resolved_max)
+}
+
+fn normalize_temperature_thresholds(
+    throttling: u32,
+    recovery: u32,
+) -> Result<(Option<u32>, Option<u32>)> {
+    if throttling > 255 || recovery > 255 {
+        return Err("temperature values must be between 0 and 255 Celsius".into());
+    }
+    Ok((
+        (throttling != 0).then_some(throttling),
+        (recovery != 0).then_some(recovery),
+    ))
+}
